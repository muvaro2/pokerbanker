{
  "rules": {
    "rooms": {
      ".read": true,
      ".indexOn": ["meta/lastActivity"],
      "$code": {
        ".write": true,
        ".validate": "$code.matches(/^[A-Z0-9]{2}$/)",
        "meta": {
          ".validate": "newData.hasChildren(['createdAt', 'lastActivity'])"
        },
        "events": {
          "$id": {
            ".validate": "newData.hasChildren(['t', 'by', 'ts']) && newData.child('t').isString()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
